# Copy thành .env và chỉ điền provider nhóm sử dụng. Không commit secret thật.

# LLM: openai | gemini | anthropic
LLM_PROVIDER=openai
LLM_MODEL=
# Số request LLM tối đa mỗi phút (free tier Gemini ~15 RPM)
LLM_RPM=12

# Generation providers
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Embedding: sentence_transformers | openai | gemini
EMBEDDING_PROVIDER=sentence_transformers
EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Optional services
PAGEINDEX_API_KEY=
JINA_API_KEY=

# Hiệu chỉnh bằng query in-domain và out-of-domain trước khi điền.
SCORE_THRESHOLD=

# Vector DB. Bắt buộc đặt nếu đường dẫn repo có dấu tiếng Việt (Chroma lỗi "Error loading hnsw index").
# CHROMA_DIR=C:/Users/<you>/.chroma/k4-day08

# Model chấm ragas (nên khác LLM_MODEL: quota free tier riêng, tránh tự chấm)
EVALUATOR_MODEL=gemini-3.1-flash-lite
